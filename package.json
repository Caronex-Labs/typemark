{
  "name": "typemark-lite",
  "version": "0.3.0",
  "description": "Framework-free seamless live-preview markdown editing engine (Typora-style): syntax appears only where the caret is.",
  "type": "module",
  "main": "./dist/typemark.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:local": "mkdir -p release && npm pack --pack-destination ./release"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "jsdom": "25.0.1",
    "mermaid": "^11.4.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11"
  },
  "private": true,
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "live-preview",
    "contenteditable"
  ],
  "license": "UNLICENSED",
  "module": "./dist/typemark.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/typemark.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/typemark.js",
    "./src/math.ts"
  ]
}
