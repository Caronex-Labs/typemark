{
  "name": "typemark-lite",
  "version": "0.1.0",
  "description": "Small framework-free seamless live-preview markdown editor (Typora-style editing model).",
  "type": "module",
  "main": "dist/typemark.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
