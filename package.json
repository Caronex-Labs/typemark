{
  "name": "@caronex/typemark",
  "version": "0.4.0",
  "description": "Seamless Typora-style markdown editing engine with an AI review layer (suggested edits, agent notes, one thread per block, @ai instructions). Framework-free, markdown as the source of truth.",
  "type": "module",
  "main": "./dist/typemark.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.standalone.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:local": "mkdir -p release && npm pack --pack-destination ./release"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "jsdom": "25.0.1",
    "mermaid": "^11.4.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "typora",
    "live-preview",
    "contenteditable",
    "ai",
    "suggestions",
    "track-changes",
    "claude",
    "mcp"
  ],
  "license": "MIT",
  "module": "./dist/typemark.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/typemark.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./standalone": "./dist/typemark.standalone.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/typemark.js",
    "./dist/typemark.standalone.js",
    "./src/math.ts",
    "./src/api.ts",
    "./src/preview.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caronex-Labs/typemark.git"
  },
  "homepage": "https://github.com/Caronex-Labs/typemark#readme",
  "bugs": {
    "url": "https://github.com/Caronex-Labs/typemark/issues"
  },
  "author": "Sameeran Bandishti",
  "publishConfig": {
    "access": "public"
  }
}
